[Unit]
Description=Reserva Edge NFC to MQTT bridge
Requires=reserva-edge-neard.service reserva-edge-nfc-poll.service
After=network-online.target reserva-edge-neard.service reserva-edge-nfc-poll.service
Wants=network-online.target
ConditionPathExists=/etc/reserva-edge/mqtt.env

[Service]
Type=simple
User=root
ExecStart=/usr/local/libexec/reserva-edge-nfc-mqtt
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

