# Install with scripts/configure-mqtt.sh. Do not commit a populated copy.
MQTT_HOST=mqtt.example.internal
MQTT_PORT=1883
MQTT_USERNAME=reserva-edge
MQTT_PASSWORD=replace-locally
MQTT_TLS=false
MQTT_DISCOVERY_PREFIX=homeassistant

# Optional. Blank values are generated from hostname and machine-id.
DEVICE_ID=
DEVICE_NAME=
TOPIC_ROOT=

