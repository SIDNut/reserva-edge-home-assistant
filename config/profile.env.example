# Copy to profile.env and edit. This file must not contain secrets.

# Existing Debian user that will run the kiosk. Leave blank to use SUDO_USER.
PROFILE_USER=

# Required Home Assistant dashboard URL.
HA_URL=https://homeassistant.local:8123

# normal, left, right, or inverted.
SCREEN_ROTATION=right

# TouchKio presentation.
TOUCHKIO_THEME=dark
TOUCHKIO_ZOOM=1.0
TOUCHKIO_WIDGET=true

# Floating Onboard geometry for the verified 800x1280 portrait session.
ONBOARD_WIDTH=800
ONBOARD_HEIGHT=260
ONBOARD_X=0
ONBOARD_Y=1020

# Seconds before the real backlight dims to 1 percent. Set 0 to disable.
IDLE_DIM_SECONDS=600

# auto enables only when the verified hardware interface is present.
# Other accepted values: true, false.
ENABLE_NFC=auto
ENABLE_LED=auto

# Refuse non-ER5A0 hardware by default.
ALLOW_UNVERIFIED_HARDWARE=false

